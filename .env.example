# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# La "publishable key" (o la "anon key" si tu proyecto aún la llama así)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# URL pública de la app (en Vercel: https://tu-app.vercel.app)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Gmail → cuenta que envía el correo del recibo de pago.
GMAIL_USER=
# "Contraseña de aplicación" (no tu contraseña normal): myaccount.google.com/apppasswords
# Requiere verificación en 2 pasos activada en esa cuenta de Google.
GMAIL_APP_PASSWORD=
# Correos que reciben el aviso cuando se sube un recibo, separados por coma
NOTIFY_EMAILS=
